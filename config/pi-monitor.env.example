# Copy to /etc/pi-monitor/pi-monitor.env; chmod 0600; owned by root.
# No export statements. One PI_NAME=value per line. See docs/configuration.md.
# Set your own protected or unguessable topic before running.

PI_NTFY_URL=https://ntfy.sh
PI_NTFY_TOPIC=REPLACE_WITH_YOUR_PRIVATE_TOPIC
PI_NTFY_TOKEN=
PI_HTTP_TIMEOUT=8.0
PI_RETRIES=3
PI_RETRY_BACKOFF=2.0
PI_QUEUE_SIZE=32
PI_NOTIFICATION_TTL=900.0
PI_NOTIFICATION_INTERVAL=5.0
PI_DEDUP_INTERVAL=60.0
PI_STATE_DIR=/var/lib/pi-monitor
PI_POLL_INTERVAL=30.0
PI_NETWORK_INTERVAL=15.0
PI_SERVICE_INTERVAL=60.0
PI_PUBLIC_IP_INTERVAL=3600.0
PI_UPDATES_INTERVAL=86400.0
PI_TEMPERATURE_ALERT=80.0
PI_TEMPERATURE_CLEAR=75.0
PI_TEMPERATURE_PATH=/sys/class/thermal/thermal_zone0/temp
PI_DISK_ALERT=10.0
PI_DISK_CLEAR=15.0
PI_DISK_PATHS=/
PI_MEMORY_ALERT_PERCENT=5.0
PI_MEMORY_CLEAR_PERCENT=10.0
PI_MEMORY_ALERT_MIB=100.0
PI_MEMORY_CLEAR_MIB=200.0
PI_LOAD_ALERT=1.5
PI_LOAD_CLEAR=1.0
PI_LOAD_SUSTAIN=300.0
PI_NETWORK_FAILURES=3
PI_NETWORK_SUCCESSES=2
PI_CONNECTIVITY_TARGETS=1.1.1.1:443,8.8.8.8:443
PI_SSH_WINDOW=300.0
PI_SSH_MIN_EVENTS=5
PI_SSH_TOP_N=5
PI_SSH_MAX_KEYS=2048
PI_CRITICAL_SERVICES=ssh.service,fail2ban.service
PI_PUBLIC_IP_ENABLED=true
PI_PUBLIC_IP_URL=https://api.ipify.org
PI_UPDATES_ENABLED=true
PI_LOG_LEVEL=INFO
